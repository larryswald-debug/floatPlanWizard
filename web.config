<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 1. Root /index.cfm should be the canonical homepage. Place before host redirect to avoid double hops. -->
        <rule name="Redirect root index cfm to canonical homepage" stopProcessing="true">
          <match url="^index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://floatplanwizard.com/"
                  redirectType="Permanent"
                  appendQueryString="false" />
        </rule>

        <!-- 2. Force the canonical public host: HTTPS non-www. -->
        <rule name="Redirect www or HTTP to canonical HTTPS non-www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\.floatplanwizard\.com$" ignoreCase="true" />
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://floatplanwizard.com/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- 3. Retired/archive content should not remain crawlable as separate URL families. -->
        <rule name="Redirect archive to homepage" stopProcessing="true">
          <match url="^archive(/.*)?$" ignoreCase="true" />
          <action type="Redirect"
                  url="/"
                  redirectType="Permanent"
                  appendQueryString="false" />
        </rule>

        <!-- 4. Great Loop Bridges canonical URL. -->
        <rule name="Redirect Great Loop Bridges CFM to Clean URL" stopProcessing="true">
          <match url="^great-loop/bridges\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/bridges/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Bridges no slash to slash" stopProcessing="true">
          <match url="^great-loop/bridges$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/bridges/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Bridges taxonomy no slash to slash" stopProcessing="true">
          <match url="^great-loop/bridges/(state|waterway|route)/([^/]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/bridges/{R:1}/{R:2}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Bridges detail no slash to slash" stopProcessing="true">
          <match url="^great-loop/bridges/([^/.]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/bridges/{R:1}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Bridges Clean State to CFM" stopProcessing="true">
          <match url="^great-loop/bridges/state/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/bridges.cfm?stateSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Bridges Clean Waterway to CFM" stopProcessing="true">
          <match url="^great-loop/bridges/waterway/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/bridges.cfm?waterwaySlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Bridges Clean Route Segment to CFM" stopProcessing="true">
          <match url="^great-loop/bridges/route/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/bridges.cfm?routeSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Bridges Clean URL to CFM" stopProcessing="true">
          <match url="^great-loop/bridges/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/bridges.cfm"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Bridges Clean Detail to CFM" stopProcessing="true">
          <match url="^great-loop/bridges/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop-bridge.cfm?slug={R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- 5. Great Loop Lock Library canonical redirects. -->
        <rule name="Redirect Great Loop Locks index CFM to Clean Main URL" stopProcessing="true">
          <match url="^great-loop/locks/index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+great-loop/locks/index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/great-loop/locks/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Locks main no slash to slash" stopProcessing="true">
          <match url="^great-loop/locks$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/locks/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Locks state or waterway no slash to slash" stopProcessing="true">
          <match url="^great-loop/locks/(state|waterway)/([^/]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/locks/{R:1}/{R:2}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Locks detail no slash to slash" stopProcessing="true">
          <match url="^great-loop/locks/([^/.]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/locks/{R:1}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- 6. Great Loop Lock Library clean routes to CFM controller. -->
        <rule name="Great Loop Locks Clean State to CFM" stopProcessing="true">
          <match url="^great-loop/locks/state/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/locks/index.cfm?stateSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Locks Clean Waterway to CFM" stopProcessing="true">
          <match url="^great-loop/locks/waterway/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/locks/index.cfm?waterwaySlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Locks Clean Main to CFM" stopProcessing="true">
          <match url="^great-loop/locks/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/locks/index.cfm"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Locks Clean Detail to CFM" stopProcessing="true">
          <match url="^great-loop/locks/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/locks/index.cfm?slug={R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- 7. Great Loop Anchorage Library canonical redirects. -->
        <rule name="Redirect Boating Guides Anchorages Alias to Great Loop Anchorages" stopProcessing="true">
          <match url="^boating-guides/anchorages/?$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/anchorages/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Anchorages index CFM to Clean Main URL" stopProcessing="true">
          <match url="^great-loop/anchorages/index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+great-loop/anchorages/index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/great-loop/anchorages/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Anchorages main no slash to slash" stopProcessing="true">
          <match url="^great-loop/anchorages$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/anchorages/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Anchorages taxonomy no slash to slash" stopProcessing="true">
          <match url="^great-loop/anchorages/(location|waterway|state|country|type)/([^/]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/anchorages/{R:1}/{R:2}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Anchorages detail no slash to slash" stopProcessing="true">
          <match url="^great-loop/anchorages/([^/.]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/anchorages/{R:1}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- 8. Great Loop Anchorage Library clean routes to CFM controller. -->
        <rule name="Great Loop Anchorages Clean Location to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/location/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?locationSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean Waterway to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/waterway/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?waterwaySlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean State to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/state/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?stateSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean Country to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/country/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?countrySlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean Type to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/type/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?typeSlug={R:1}"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean Main to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Anchorages Clean Detail to CFM" stopProcessing="true">
          <match url="^great-loop/anchorages/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/anchorages/index.cfm?slug={R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- 9. Great Loop Ports Library canonical redirects and clean routes. -->
        <rule name="Redirect Great Loop Ports index CFM to Clean Main URL" stopProcessing="true">
          <match url="^great-loop/ports/index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+great-loop/ports/index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/great-loop/ports/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Ports main no slash to slash" stopProcessing="true">
          <match url="^great-loop/ports$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/ports/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Great Loop Ports detail no slash to slash" stopProcessing="true">
          <match url="^great-loop/ports/([^/.]+)$" ignoreCase="true" />
          <action type="Redirect"
                  url="/great-loop/ports/{R:1}/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Ports Clean Main to CFM" stopProcessing="true">
          <match url="^great-loop/ports/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/ports/index.cfm"
                  appendQueryString="true" />
        </rule>

        <rule name="Great Loop Ports Clean Detail to CFM" stopProcessing="true">
          <match url="^great-loop/ports/([^/]+)/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/great-loop/ports/index.cfm?slug={R:1}"
                  appendQueryString="true" />
        </rule>

        <!-- 9. Boat Fuel Calculator canonical URL. -->
        <rule name="Redirect Fuel Calculator CFM to Clean URL" stopProcessing="true">
          <match url="^boat-fuel-calculator/boat-fuel-calculator\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/boat-fuel-calculator/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect boat fuel calculator no slash to slash" stopProcessing="true">
          <match url="^boat-fuel-calculator$" ignoreCase="true" />
          <action type="Redirect"
                  url="/boat-fuel-calculator/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Fuel Calculator Clean URL to CFM" stopProcessing="true">
          <match url="^boat-fuel-calculator/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/boat-fuel-calculator/boat-fuel-calculator.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- About FloatPlanWizard canonical URL. -->
        <rule name="Redirect About CFM to Clean URL" stopProcessing="true">
          <match url="^about\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+about\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/about"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect About Trailing Slash to Canonical URL" stopProcessing="true">
          <match url="^about/$" ignoreCase="true" />
          <action type="Redirect"
                  url="/about"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="About Clean URL to CFM" stopProcessing="true">
          <match url="^about$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/about.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 10. Why Use a Float Plan canonical URL. -->
        <rule name="Redirect Why Float Plan CFM to Clean URL" stopProcessing="true">
          <match url="^why-use-a-float-plan\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/why-use-a-float-plan/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect why float plan no slash to slash" stopProcessing="true">
          <match url="^why-use-a-float-plan$" ignoreCase="true" />
          <action type="Redirect"
                  url="/why-use-a-float-plan/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Why Use a Float Plan Clean URL to CFM" stopProcessing="true">
          <match url="^why-use-a-float-plan/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/why-use-a-float-plan.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 9. How It Works canonical URL. -->
        <rule name="Redirect How It Works CFM to Clean URL" stopProcessing="true">
          <match url="^how-it-works\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/how-it-works/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect how it works no slash to slash" stopProcessing="true">
          <match url="^how-it-works$" ignoreCase="true" />
          <action type="Redirect"
                  url="/how-it-works/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="How It Works Clean URL to CFM" stopProcessing="true">
          <match url="^how-it-works/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/how-it-works.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 10. FAQ canonical URL. -->
        <rule name="Redirect FAQ CFM to Clean URL" stopProcessing="true">
          <match url="^faq\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/faq/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect FAQ no slash to slash" stopProcessing="true">
          <match url="^faq$" ignoreCase="true" />
          <action type="Redirect"
                  url="/faq/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="FAQ Clean URL to CFM" stopProcessing="true">
          <match url="^faq/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/faq/index.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 11. Boating Guides: Nautical Charts canonical URL. -->
        <rule name="Redirect Nautical Charts Guide index CFM to Clean URL" stopProcessing="true">
          <match url="^boating-guides/nautical-charts/index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+boating-guides/nautical-charts/index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/boating-guides/nautical-charts/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect Nautical Charts Guide no slash to slash" stopProcessing="true">
          <match url="^boating-guides/nautical-charts$" ignoreCase="true" />
          <action type="Redirect"
                  url="/boating-guides/nautical-charts/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Nautical Charts Guide Clean URL to CFM" stopProcessing="true">
          <match url="^boating-guides/nautical-charts/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/boating-guides/nautical-charts/index.cfm"
                  appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
