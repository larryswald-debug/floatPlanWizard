<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 1. Force canonical host + HTTPS: non-www -->
        <rule name="Redirect www or HTTP to canonical HTTPS non-www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\.floatplanwizard\.com$" ignoreCase="true" />
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://floatplanwizard.com/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- 2. Redirect /index.cfm to homepage, only when directly requested -->
        <rule name="Redirect index cfm to homepage safe" stopProcessing="true">
          <match url="^index\.cfm$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="\s/+index\.cfm[\s?]" ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="/"
                  redirectType="Permanent"
                  appendQueryString="false" />
        </rule>

        <!-- 3. Redirect archive URLs -->
        <rule name="Redirect archive to homepage" stopProcessing="true">
          <match url="^archive(/.*)?$" ignoreCase="true" />
          <action type="Redirect"
                  url="/"
                  redirectType="Permanent"
                  appendQueryString="false" />
        </rule>

        <!-- 4. Fuel Calculator canonical redirects -->
        <rule name="Redirect Fuel Calculator CFM to Clean URL" stopProcessing="true">
          <match url="^boat-fuel-calculator/boat-fuel-calculator\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/boat-fuel-calculator/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect boat fuel calculator no slash to slash" stopProcessing="true">
          <match url="^boat-fuel-calculator$" ignoreCase="true" />
          <action type="Redirect"
                  url="/boat-fuel-calculator/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Fuel Calculator Clean URL to CFM" stopProcessing="true">
          <match url="^boat-fuel-calculator/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/boat-fuel-calculator/boat-fuel-calculator.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 5. Why Use a Float Plan canonical redirects -->
        <rule name="Redirect Why Float Plan CFM to Clean URL" stopProcessing="true">
          <match url="^why-use-a-float-plan\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/why-use-a-float-plan/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect why float plan no slash to slash" stopProcessing="true">
          <match url="^why-use-a-float-plan$" ignoreCase="true" />
          <action type="Redirect"
                  url="/why-use-a-float-plan/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Why Use a Float Plan Clean URL to CFM" stopProcessing="true">
          <match url="^why-use-a-float-plan/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/why-use-a-float-plan.cfm"
                  appendQueryString="true" />
        </rule>

        <!-- 6. How It Works canonical redirects -->
        <rule name="Redirect How It Works CFM to Clean URL" stopProcessing="true">
          <match url="^how-it-works\.cfm$" ignoreCase="true" />
          <action type="Redirect"
                  url="/how-it-works/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="Redirect how it works no slash to slash" stopProcessing="true">
          <match url="^how-it-works$" ignoreCase="true" />
          <action type="Redirect"
                  url="/how-it-works/"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <rule name="How It Works Clean URL to CFM" stopProcessing="true">
          <match url="^how-it-works/$" ignoreCase="true" />
          <action type="Rewrite"
                  url="/how-it-works.cfm"
                  appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>