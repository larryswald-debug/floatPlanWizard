{
  "baseUrl": "http://localhost:8500",
  "pathName": "/fpw/app/dashboard.cfm",
  "loginPath": "/fpw/index.cfm",
  "appReadySelector": "#floatPlansPanel",
  "locale": "en-US",
  "hostTimezone": "America/New_York",
  "outputDir": "floatplans-timezone-debug-output",
  "screenshotMode": "failures",
  "allTimezones": true,
  "useClock": true,
  "probes": [
    {
      "name": "floatplans-panel",
      "stage": "dashboard",
      "selector": "#floatPlansPanel",
      "extract": "text"
    },
    {
      "name": "plan-row",
      "stage": "dashboard",
      "selector": "#floatPlansList [data-plan-id=\"{{floatPlanId}}\"]",
      "extract": "text"
    },
    {
      "name": "plan-meta",
      "stage": "dashboard",
      "selector": "#floatPlansList [data-plan-id=\"{{floatPlanId}}\"] small",
      "extract": "text"
    },
    {
      "name": "wizard-step-title",
      "stage": "edit-step2",
      "selector": "#floatPlanWizardModal h2.h5",
      "extract": "text"
    }
  ],
  "timeFields": [
    {
      "name": "browser-fixed-now",
      "source": "fact",
      "key": "browserFixedNowLocal",
      "assertionMode": "absolute",
      "expectedStrategy": "formatInstant"
    },
    {
      "name": "departure-input",
      "stage": "edit-step2",
      "selector": "#floatPlanWizardModal [name=\"DEPARTURE_TIME\"]",
      "extract": "value",
      "assertionMode": "floating"
    },
    {
      "name": "departure-timezone",
      "stage": "edit-step2",
      "selector": "#departureTimezone",
      "extract": "value",
      "assertionMode": "floating"
    },
    {
      "name": "return-input",
      "stage": "edit-step2",
      "selector": "#floatPlanWizardModal [name=\"RETURN_TIME\"]",
      "extract": "value",
      "assertionMode": "floating"
    },
    {
      "name": "return-timezone",
      "stage": "edit-step2",
      "selector": "#returnTimezone",
      "extract": "value",
      "assertionMode": "floating"
    },
    {
      "name": "plan-meta",
      "stage": "dashboard",
      "selector": "#floatPlansList [data-plan-id=\"{{floatPlanId}}\"] small",
      "extract": "text",
      "assertionMode": "floating"
    }
  ],
  "testInstants": [
    "2026-03-08T06:59:59Z",
    "2026-03-08T07:00:00Z",
    "2026-11-01T05:59:59Z",
    "2026-11-01T06:00:00Z",
    "2026-12-31T23:30:00Z",
    "2027-01-01T00:30:00Z"
  ],
  "runMonitorLimit": 100,
  "routeTemplateCodes": [
    "GULF-CORE",
    "GULF-WEST",
    "GL_REUSE_V2"
  ]
}