<cfsetting showdebugoutput="false">
<cfcontent type="text/html; charset=utf-8">
<cfscript>
userStruct = (structKeyExists(session, "user") AND isStruct(session.user)) ? session.user : {};
isLoggedIn = structCount(userStruct) GT 0;
isAdmin = false;
// Authorization is enforced centrally by Application.cfc.
function boolLike(any value, boolean defaultValue=false) { var txt=lCase(trim(toString(arguments.value))); if (!len(txt)) return arguments.defaultValue; if (listFindNoCase("1,true,yes,y,on",txt)) return true; if (listFindNoCase("0,false,no,n,off",txt)) return false; if (isNumeric(txt)) return val(txt) NEQ 0; return arguments.defaultValue; }
isAuthorized=structKeyExists(request, "fpwAdminAuthorization") AND request.fpwAdminAuthorization.authorized;
if (isAuthorized AND !structKeyExists(session,"adminMemberEntitlementsNonce")) session.adminMemberEntitlementsNonce=createUUID();
</cfscript>
<cfinclude template="../includes/fpw_base_path.cfm">
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Member Entitlements</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
<style>
body{margin:24px;background:#f7f7f7;color:#111;font-family:Arial,sans-serif}.admin-wrap{max-width:1560px;margin:0 auto;padding:20px;border:1px solid #ddd;border-radius:8px;background:#fff}.filter-grid{display:grid;grid-template-columns:minmax(240px,2fr) repeat(5,minmax(125px,1fr));gap:10px}.filter-grid label{display:block;margin-bottom:4px;color:#333;font-size:12px;font-weight:700}.toolbar-actions,.pager{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.toolbar-actions{margin:12px 0}.pager{justify-content:flex-end;margin-top:12px}.admin-message{display:none;margin:12px 0;padding:10px;border-radius:5px}.admin-message.info,.admin-message.success,.admin-message.error{display:block}.admin-message.info{background:#edf2ff;border:1px solid #b6c6ff;color:#13255a}.admin-message.success{background:#e9f8ee;border:1px solid #9dd9ad;color:#0e5522}.admin-message.error{background:#ffecec;border:1px solid #ffb4b4;color:#7f1d1d}.table th{white-space:nowrap}.table td{vertical-align:top}.stripe-managed{background:#fff8e1}.detail-panel{max-height:270px;overflow:auto;border:1px solid #ddd;border-radius:5px}.member-result{cursor:pointer}.member-result:hover{background:#f2f6ff}@media(max-width:1100px){.filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){body{margin:10px}.admin-wrap{padding:12px}.filter-grid{grid-template-columns:1fr}}
</style></head><body><div class="admin-wrap"><cfinclude template="includes/admin_reports_nav.cfm"><div class="d-flex justify-content-between align-items-start flex-wrap gap-2"><div><h1 class="h3 mb-1">Member Entitlements</h1><p class="text-muted">View canonical effective access and safely grant, extend, annotate, or revoke internal entitlements. Stripe-managed rows are protected.</p></div><cfif isAuthorized><button class="btn btn-primary" id="grantEntitlementBtn" type="button">Grant Entitlement</button></cfif></div>
<cfif NOT isAuthorized><div class="alert alert-danger"><strong>Unauthorized:</strong> Admin login is required.</div><cfelse>
<div id="entitlementMessage" class="admin-message"></div><form id="entitlementFilters"><div class="filter-grid"><div><label for="entitlementSearch">Search</label><input class="form-control" id="entitlementSearch" placeholder="member, email, ID, promo, Stripe ID"></div><div><label for="entitlementLifecycle">Status / Kind</label><select class="form-select" id="entitlementLifecycle"><option value="">All</option><option>active</option><option>scheduled</option><option>expired</option><option>revoked</option><option>trial</option><option>complimentary</option><option>lifetime</option><option>stripe</option><option>promo</option></select></div><div><label for="entitlementSource">Source</label><select class="form-select" id="entitlementSource"><option value="">All</option><option value="founder_lifetime">Founder lifetime</option><option value="stripe_subscription">Stripe subscription</option><option value="three_day_pass">Three-day pass</option><option value="admin_comp">Admin comp</option></select></div><div><label for="entitlementSort">Sort</label><select class="form-select" id="entitlementSort"><option value="updated">Updated</option><option value="member">Member</option><option value="email">Email</option><option value="source">Source</option><option value="status">Status</option><option value="starts">Starts</option><option value="expires">Expires</option><option value="created">Created</option></select></div><div><label for="entitlementDirection">Direction</label><select class="form-select" id="entitlementDirection"><option value="desc">Descending</option><option value="asc">Ascending</option></select></div><div><label for="entitlementLimit">Page Size</label><select class="form-select" id="entitlementLimit"><option>25</option><option selected>50</option><option>100</option><option>200</option></select></div></div><div class="toolbar-actions"><button class="btn btn-dark" type="submit">Search</button><button class="btn btn-outline-secondary" id="resetEntitlementFilters" type="button">Reset</button></div></form><div id="entitlementSummary" class="small text-muted mb-2">Loading entitlements...</div><div class="table-responsive"><table class="table table-sm table-bordered"><thead class="table-light"><tr><th>Member</th><th>Entitlement</th><th>Status</th><th>Source / Kind</th><th>Promo</th><th>Start / Expiration (UTC)</th><th>Stripe</th><th>Actions</th></tr></thead><tbody id="entitlementTableBody"><tr><td colspan="8">Loading...</td></tr></tbody></table></div><div class="pager"><button class="btn btn-sm btn-outline-secondary" id="entitlementPrev" type="button">Previous</button><span id="entitlementPage">Page 1</span><button class="btn btn-sm btn-outline-secondary" id="entitlementNext" type="button">Next</button></div>
</cfif></div>
<cfif isAuthorized>
<div class="modal fade" id="grantModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><form id="grantForm"><div class="modal-header"><h2 class="modal-title h5">Grant Member Entitlement</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" id="grantUserId" value="0"><div class="row g-3"><div class="col-12"><label class="form-label" for="memberSearch">Find member</label><div class="input-group"><input class="form-control" id="memberSearch" placeholder="name, email, or member ID"><button class="btn btn-outline-secondary" id="memberSearchBtn" type="button">Search</button></div><div id="memberSearchResults" class="list-group mt-2"></div><div id="selectedMember" class="alert alert-secondary mt-2 d-none"></div></div><div class="col-md-6"><label class="form-label" for="grantKind">Grant type</label><select class="form-select" id="grantKind"><option value="trial">Trial</option><option value="fixed_duration">Premium fixed duration</option><option value="fixed_expiration">Premium through expiration</option><option value="complimentary">Complimentary membership</option><option value="lifetime">Founder lifetime</option><option value="manual">Manual Premium</option><option value="promo">Internal promo-based grant</option></select></div><div class="col-md-6"><label class="form-label" for="grantPromoId">Internal promo ID</label><input class="form-control" id="grantPromoId" type="number" min="1" placeholder="Required only for promo grant"></div><div class="col-md-4"><label class="form-label" for="grantStarts">Starts at (UTC)</label><input class="form-control" id="grantStarts" type="datetime-local" required></div><div class="col-md-4"><label class="form-label" for="grantDurationDays">Duration days</label><input class="form-control" id="grantDurationDays" type="number" min="1" max="36500"></div><div class="col-md-4"><label class="form-label" for="grantExpires">Expires at (UTC)</label><input class="form-control" id="grantExpires" type="datetime-local"></div><div class="col-12"><label class="form-label" for="grantNotes">Administrative notes</label><textarea class="form-control" id="grantNotes" rows="3"></textarea></div><div class="col-12"><label class="form-label" for="grantReason">Reason</label><input class="form-control" id="grantReason" maxlength="500" required></div><div class="col-12"><button class="btn btn-outline-secondary btn-sm" id="checkOverlapBtn" type="button">Check overlap</button><div id="overlapResults" class="mt-2"></div><div class="form-check mt-2"><input class="form-check-input" id="confirmOverlap" type="checkbox"><label class="form-check-label" for="confirmOverlap">I confirm this grant may overlap or supersede existing access.</label></div></div></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Grant entitlement</button></div></form></div></div></div>
<div class="modal fade" id="memberDetailModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="memberDetailTitle">Member Entitlement Detail</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div id="memberSummary"></div><div id="effectiveAccessSummary" class="alert alert-info"></div><h3 class="h6">All entitlement records</h3><div class="detail-panel"><table class="table table-sm mb-0"><thead><tr><th>ID</th><th>Status</th><th>Source</th><th>Dates</th><th>Notes</th><th>Actions</th></tr></thead><tbody id="memberEntitlementRows"></tbody></table></div><h3 class="h6 mt-3">Promo redemption history</h3><div class="detail-panel"><table class="table table-sm mb-0"><tbody id="memberRedemptionRows"></tbody></table></div><h3 class="h6 mt-3">Admin audit history</h3><div class="detail-panel"><table class="table table-sm mb-0"><tbody id="memberAuditRows"></tbody></table></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button></div></div></div></div>
<div class="modal fade" id="entitlementActionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"><div class="modal-dialog modal-dialog-scrollable"><div class="modal-content"><form id="entitlementActionForm" novalidate><div class="modal-header"><h2 class="modal-title h5" id="entitlementActionTitle">Entitlement Action</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><input type="hidden" id="entitlementActionId" value="0"><input type="hidden" id="entitlementActionUserId" value="0"><div id="entitlementActionContext" class="alert alert-info py-2"></div><div id="entitlementActionError" class="alert alert-danger py-2 d-none"></div><div id="entitlementActionExpiresWrap" class="mb-3 d-none"><label class="form-label" for="entitlementActionExpires">New expiration (UTC)</label><input class="form-control" id="entitlementActionExpires" type="datetime-local"></div><div id="entitlementActionNotesWrap" class="mb-3 d-none"><label class="form-label" for="entitlementActionNotes">Administrative notes</label><textarea class="form-control" id="entitlementActionNotes" rows="4"></textarea></div><div id="entitlementActionConfirmationWrap" class="mb-3 d-none"><label class="form-label" for="entitlementActionConfirmation">Confirmation</label><input class="form-control" id="entitlementActionConfirmation" autocomplete="off"><div id="entitlementActionConfirmationHint" class="form-text"></div></div><div><label class="form-label" for="entitlementActionReason">Reason</label><input class="form-control" id="entitlementActionReason" maxlength="500" required></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" id="entitlementActionSubmit" type="submit">Save</button></div></form></div></div></div>
</cfif>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script><cfif isAuthorized><cfoutput><script>window.FPW_ADMIN_ENTITLEMENT_CONFIG={endpoint:#serializeJSON(request.fpwApiBase & "/adminMemberEntitlements.cfc?method=handle")#,nonce:#serializeJSON(session.adminMemberEntitlementsNonce)#};</script></cfoutput><script src="<cfoutput>#encodeForHtmlAttribute(request.fpwBase)#</cfoutput>/assets/js/app/admin/member-entitlements.js?v=<cfoutput>#encodeForHtmlAttribute(request.fpwAdminAssetVersion)#</cfoutput>"></script></cfif></body></html>





