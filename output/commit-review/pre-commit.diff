diff --git a/assets/css/top-nav.css b/assets/css/top-nav.css
index 865f5aa..b80f343 100644
--- a/assets/css/top-nav.css
+++ b/assets/css/top-nav.css
@@ -1742,3 +1742,368 @@
   background-color: #8bcf9b;
   color: #000000;
 }
+
+/* Approved October 2026 shared navigation. Keep legacy public CTA, app-subnav,
+   and login-strip styles above for their existing consumers. */
+.fpw-site-header.fpw-nav-v2 {
+  --fpw-nav-layout-max: 1510px;
+  --fpw-nav-bg: #03121e;
+  --fpw-nav-panel: #031b2b;
+  --fpw-nav-teal: #16d9eb;
+  --fpw-nav-white: #f7fbff;
+  --fpw-nav-muted: #c2d7e5;
+  --fpw-nav-border: #164354;
+  color: var(--fpw-nav-white);
+  background: var(--fpw-nav-bg);
+  border-bottom: 1px solid #11556c;
+  box-shadow: none;
+  font-family: Arial, Helvetica, sans-serif;
+}
+.fpw-site-header.fpw-nav-v2::before { display: none; }
+.fpw-site-header.fpw-nav-v2 [hidden] { display: none !important; }
+.fpw-site-header.fpw-nav-v2 a { text-decoration: none; }
+.fpw-site-header.fpw-nav-v2 a:focus-visible,
+.fpw-site-header.fpw-nav-v2 button:focus-visible {
+  outline: 2px solid #f6c45b;
+  outline-offset: 3px;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-launch-strip {
+  min-height: 30px;
+  background: #021c2a;
+  border: 0;
+  backdrop-filter: none;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-launch-inner {
+  width: calc(100% - 32px);
+  max-width: 1510px;
+  min-height: 30px;
+  padding: 5px 0;
+  justify-content: center;
+  flex-wrap: wrap;
+  overflow: visible;
+  gap: 6px;
+  font-size: 12px;
+  line-height: 1.35;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-launch-copy { white-space: normal; text-align: center; }
+.fpw-site-header.fpw-nav-v2 .fpw-launch-link { white-space: nowrap; }
+.fpw-site-header.fpw-nav-v2 .fpw-launch-icon { filter: none; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-shell { width: 100%; padding: 0; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-inner {
+  width: 100%;
+  max-width: 1510px;
+  min-height: 80px;
+  margin: 0 auto;
+  padding: 10px 28px;
+  display: flex;
+  gap: 24px;
+  align-items: center;
+  justify-content: space-between;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-brand { gap: 12px; min-width: 0; flex: 0 0 auto; }
+.fpw-site-header.fpw-nav-v2 .fpw-brand__mark { width: 56px; height: 56px; flex: 0 0 56px; color: var(--fpw-nav-teal); }
+.fpw-site-header.fpw-nav-v2 .fpw-helm-icon { width: 100%; height: 100%; }
+.fpw-site-header.fpw-nav-v2 .fpw-brand__name { font-size: 29px; font-weight: 800; line-height: 1.04; letter-spacing: -1px; }
+.fpw-site-header.fpw-nav-v2 .fpw-brand__tagline { display: block; color: var(--fpw-nav-teal); font-size: 8px; font-weight: 800; line-height: 1.3; letter-spacing: .25px; margin-top: 5px; text-transform: uppercase; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-menu {
+  position: static;
+  display: flex;
+  flex: 1 1 auto;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  width: auto;
+  height: auto;
+  padding: 0;
+  margin: 0;
+  background: none;
+  border: 0;
+  box-shadow: none;
+  visibility: visible;
+  opacity: 1;
+  transform: none;
+  overflow: visible;
+  pointer-events: auto;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-primary-nav,
+.fpw-site-header.fpw-nav-v2 .fpw-nav-actions { display: flex; align-items: center; flex-direction: row; flex-wrap: nowrap; width: auto; gap: 8px; margin: 0; }
+.fpw-site-header.fpw-nav-v2 .fpw-primary-nav { margin-inline: auto; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-actions { gap: 18px; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-link,
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown-toggle {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  width: auto;
+  min-height: 50px;
+  padding: 0 9px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--fpw-nav-white);
+  font-family: Arial, Helvetica, sans-serif !important;
+  font-size: 15px !important;
+  font-weight: 700 !important;
+  line-height: 1.15 !important;
+  white-space: nowrap;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown-toggle::after { display: none; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-link:hover,
+.fpw-site-header.fpw-nav-v2 .fpw-nav-link.is-active,
+.fpw-site-header.fpw-nav-v2 .fpw-nav-link[aria-expanded="true"] { color: var(--fpw-nav-teal); }
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown-toggle[aria-expanded="true"] { background: #063047; }
+.fpw-site-header.fpw-nav-v2 .fpw-approved-icon { flex: 0 0 auto; width: 25px; height: 25px; color: inherit; }
+.fpw-site-header.fpw-nav-v2 .fpw-approved-icon * { vector-effect: non-scaling-stroke; stroke-width: 1.5px; }
+.fpw-site-header.fpw-nav-v2 .fpw-nav-icon { width: 23px; height: 23px; flex: 0 0 23px; }
+.fpw-site-header.fpw-nav-v2 .fpw-chevron { width: 13px; height: 13px; flex: 0 0 13px; stroke: currentColor; fill: none; stroke-width: 1.6; }
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown { position: relative; width: auto; }
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown-menu {
+  position: absolute;
+  display: block;
+  top: calc(100% + 10px);
+  left: 0;
+  right: auto;
+  width: 330px;
+  max-width: calc(100vw - 32px);
+  margin: 0;
+  padding: 22px;
+  color: var(--fpw-nav-white);
+  background: #031b2b;
+  border: 1px solid #0b98b6;
+  border-radius: 12px;
+  box-shadow: 0 16px 40px rgba(0,0,0,.42);
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: translateX(var(--fpw-menu-shift, 0px));
+  overflow: visible;
+  z-index: 20;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-dropdown-menu::before {
+  content: "";
+  display: block;
+  position: absolute;
+  left: var(--fpw-pointer-left, 55px);
+  top: -6px;
+  width: 11px;
+  height: 11px;
+  background: #031b2b;
+  border-top: 1px solid #0b98b6;
+  border-left: 1px solid #0b98b6;
+  transform: translateX(-50%) rotate(45deg);
+}
+.fpw-site-header.fpw-nav-v2 .fpw-menu-heading { display: flex; align-items: flex-start; gap: 14px; margin: 0 0 10px; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-heading > svg { width: 32px; height: 32px; color: var(--fpw-nav-teal); }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-heading h2 { margin: 0 0 4px; color: var(--fpw-nav-white); font-size: 17px; line-height: 1.25; font-weight: 700; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-heading p { color: var(--fpw-nav-muted); font-size: 13px; line-height: 1.4; margin: 0; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row,
+.fpw-site-header.fpw-nav-v2 .fpw-account-dropdown .fpw-dropdown-menu > a {
+  display: flex;
+  align-items: center;
+  justify-content: flex-start;
+  gap: 14px;
+  width: 100%;
+  min-height: 54px;
+  margin: 0;
+  padding: 11px 0;
+  border: 0;
+  border-radius: 0;
+  color: var(--fpw-nav-white);
+  background: transparent;
+  font-size: 14px;
+  text-align: left;
+  white-space: normal;
+}
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row > span:not(.fpw-menu-arrow) { min-width: 0; flex: 1 1 auto; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row-icon { color: var(--fpw-nav-teal); width: 27px; height: 27px; }
+.fpw-site-header.fpw-nav-v2 .fpw-icon--yellow { color: #ffd400; }
+.fpw-site-header.fpw-nav-v2 .fpw-icon--orange { color: #f06435; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row strong,
+.fpw-site-header.fpw-nav-v2 .fpw-account-dropdown strong { display: block; font-size: 14px; font-weight: 700; line-height: 1.3; color: inherit; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row small,
+.fpw-site-header.fpw-nav-v2 .fpw-account-dropdown small { display: block; color: var(--fpw-nav-muted); font-size: 12px; line-height: 1.4; margin-top: 3px; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-arrow { flex: 0 0 auto; color: var(--fpw-nav-teal); font-size: 19px; line-height: 1; margin-left: auto; }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row:hover,
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row[aria-current="page"],
+.fpw-site-header.fpw-nav-v2 .fpw-guide-menu-card:hover,
+.fpw-site-header.fpw-nav-v2 .fpw-guide-menu-card[aria-current="page"] { color: var(--fpw-nav-teal); }
+.fpw-site-header.fpw-nav-v2 .fpw-menu-row--separator { border-top: 1px solid #194052; margin-top: 8px; padding-top: 17px; }
